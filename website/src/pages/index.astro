---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { ThemedShot } from '../components/ThemedShot'
import { ThemedVideo } from '../components/ThemedVideo'
import { RevealOnScroll } from '../components/RevealOnScroll'
import { CopyButton } from '../components/CopyButton'
import { ThemePickerRow } from '../components/mockups/ThemePickerRow'
import { HeatmapFillIn } from '../components/mockups/HeatmapFillIn'

const shipCommand = `docker run -d \\
  --name tome \\
  --restart unless-stopped \\
  -p 8080:8080 \\
  -v ./data:/data \\
  -v ./books:/books \\
  -v ./bindery:/bindery \\
  ghcr.io/bndct-devops/tome:latest`

// Footer version: read from the repo at build time so it never goes stale.
import { readFileSync } from 'node:fs'
const releaseLabel = (() => {
  try {
    const py = readFileSync(new URL('../../../pyproject.toml', import.meta.url), 'utf8')
    const v = py.match(/^version\s*=\s*"([^"]+)"/m)?.[1]
    const cl = readFileSync(new URL('../../../CHANGELOG.md', import.meta.url), 'utf8')
    const name = v ? cl.match(new RegExp('^## \\[' + v.replace(/\./g, '\\.') + '\\][^\n]*?"([^"]+)"', 'm'))?.[1] : undefined
    return v ? `v${v}${name ? ' · ' + name : ''}` : 'tome.bndct.sh'
  } catch { return 'tome.bndct.sh' }
})()
---
<BaseLayout title="Tome — A self-hosted ebook library that knows how you read">
  <SiteHeader />


  <main>
  <!-- Hero -->
  <section class="relative max-w-6xl mx-auto px-6 pt-32 pb-24 text-center">
    <div class="accent-glow"></div>
    <p class="reveal inline-block mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">
      Made for KOReader users who actually read.
    </p>
    <h1 class="reveal text-5xl md:text-7xl font-bold tracking-tight mb-6 max-w-4xl mx-auto leading-[1.05]">
      A self-hosted ebook library that <span class="text-[var(--accent)]">knows how you read</span>.
    </h1>
    <p class="reveal text-lg md:text-xl text-[var(--muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
      Most library servers stop at file management. Tome connects to your e-reader, records every reading session,
      syncs positions both ways, and turns it into stats that get sharper the more you read.
    </p>
    <div class="reveal flex items-center justify-center gap-3 mb-16">
      <a href="https://github.com/bndct-devops/tome#quick-start" class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[var(--accent)] text-[var(--accent-fg)] font-medium hover:opacity-90 hover:scale-[1.02] transition-all">
        Quick start
      </a>
      <a href="https://github.com/bndct-devops/tome" class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border bg-[var(--card)] font-medium hover:bg-[var(--bg)] hover:scale-[1.02] transition-all">
        View on GitHub
      </a>
    </div>

    <div class="reveal max-w-5xl mx-auto rounded-xl overflow-hidden border shadow-2xl shadow-[var(--accent-soft)]">
      <ThemedVideo name="hero" client:load className="w-full block" />
    </div>
    <p class="reveal mt-4 text-sm text-[var(--muted)]">Toggle theme in the header at any time · click any screenshot below to zoom.</p>
  </section>

  <!-- Feature 1: home / continuity -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-5">A home that knows your habits.</h2>
        <p class="text-lg md:text-xl text-[var(--muted)] leading-relaxed">
          Continue where you left off, see your streak, glance at what just landed in the library.
          Built from real reading-session data — not just file metadata.
        </p>
      </div>
      <div class="reveal screenshot-card rounded-xl overflow-hidden border bg-[var(--card)] shadow-xl">
        <ThemedShot name="home" alt="Tome home screen" client:load className="w-full block" />
      </div>
    </div>
  </section>

  <!-- TomeSync — kept between feature 1 and 2 -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="text-center mb-12 reveal">
      <span class="inline-block px-3 py-1 mb-4 rounded-full text-xs font-medium bg-[var(--accent-soft)] text-[var(--accent)] uppercase tracking-wide">TomeSync</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">30 seconds to KOReader sync.</h2>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto leading-relaxed">
        Other tools document how to set up KOSync. Tome ships a plugin pre-configured
        with your server URL and a fresh API key — no manual entry, no account, no guessing.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 reveal max-w-4xl mx-auto">
      <div class="setup-card setup-card-them">
        <div class="setup-card-header">
          <span class="setup-card-label">With KOSync (everyone else)</span>
        </div>
        <ol class="setup-steps">
          <li>Install the KOSync KOReader plugin</li>
          <li>Open it, enter your server URL</li>
          <li>Register a username</li>
          <li>Enter and confirm a password</li>
          <li>Configure auto-sync intervals</li>
          <li>Hope the connection works</li>
        </ol>
      </div>
      <div class="setup-card setup-card-us">
        <div class="setup-card-header">
          <span class="setup-card-label">With TomeSync</span>
        </div>
        <ol class="setup-steps">
          <li>Click <strong>Download plugin ZIP</strong> in Tome's Settings</li>
          <li>Drop the <code>.koplugin</code> into KOReader's plugins folder</li>
          <li>Restart KOReader. Done.</li>
        </ol>
        <div class="setup-card-footer">
          Self-registers in the wrench menu. Server URL and API key are baked in.
        </div>
      </div>
    </div>

    <!-- Benefit cards: 2x2 grid -->
    <div class="grid md:grid-cols-2 gap-4 mt-12 max-w-4xl mx-auto reveal">
      <div class="rounded-xl border bg-[var(--card)] p-5">
        <div class="font-semibold mb-1.5">Records sessions, not just position</div>
        <p class="text-sm text-[var(--muted)] leading-relaxed">
          Time on page, pages turned, device — every reading minute feeds your stats.
          Plain KOSync only syncs where you stopped.
        </p>
      </div>
      <div class="rounded-xl border bg-[var(--card)] p-5">
        <div class="font-semibold mb-1.5">Browse and download series from KOReader</div>
        <p class="text-sm text-[var(--muted)] leading-relaxed">
          Open the wrench menu, pick a series, hit "Download rest". Files arrive
          organised by book-type folder with proper filenames. No OPDS gymnastics.
        </p>
      </div>
      <div class="rounded-xl border bg-[var(--card)] p-5">
        <div class="font-semibold mb-1.5">Web reader and KOReader stay in lockstep</div>
        <p class="text-sm text-[var(--muted)] leading-relaxed">
          Read on the couch in the browser, pick up on KOReader in bed, come back
          to the browser the next morning. Bidirectional. Offline-first — sessions
          queue and flush when you're back online.
        </p>
      </div>
      <div class="rounded-xl border bg-[var(--card)] p-5">
        <div class="font-semibold mb-1.5">Stable book IDs, not file hashes</div>
        <p class="text-sm text-[var(--muted)] leading-relaxed">
          KOSync identifies books by MD5 of the file — edit metadata, re-save,
          redownload and the sync history orphans. Tome resolves to a canonical
          book ID. Your reading history survives file changes.
        </p>
      </div>
    </div>

    <p class="reveal text-center text-sm text-[var(--muted)] mt-8 max-w-2xl mx-auto">
      Not using KOReader? Tome also serves an <a href="/docs/opds" class="text-[var(--accent)] hover:underline">OPDS catalog</a> for any reader that supports it.
    </p>
  </section>

  <!-- Feature 2: series & arcs (keeps the static screenshot) -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal md:order-2">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-5">Series, not just files.</h2>
        <p class="text-lg md:text-xl text-[var(--muted)] leading-relaxed">
          Manga, light novels, multi-volume sagas — Tome groups volumes into arcs, tracks progress per book,
          and remembers which arc you finished. Status badges show ongoing vs completed.
        </p>
      </div>
      <div class="reveal screenshot-card rounded-xl overflow-hidden border bg-[var(--card)] shadow-xl md:order-1">
        <ThemedShot name="series-detail" alt="Series detail with arcs" client:load className="w-full block" />
      </div>
    </div>
  </section>

  <!-- Feature 3: stats -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-5">Stats that get sharper the more you read.</h2>
        <p class="text-lg md:text-xl text-[var(--muted)] leading-relaxed">
          Streaks, reading goals, time-of-day heatmaps, reading pace, completion estimates. Every minute on your e-reader
          feeds back into actionable insight, not vanity metrics.
        </p>
      </div>
      <div class="reveal screenshot-card rounded-xl overflow-hidden border bg-[var(--card)] shadow-xl">
        <ThemedShot name="stats-overview" alt="Stats overview" client:load className="w-full block" />
      </div>
    </div>
  </section>

  <!-- Feature 4: Hardcover sync -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="reveal md:order-2">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-5">Your shelf, live on Hardcover.</h2>
        <p class="text-lg md:text-xl text-[var(--muted)] leading-relaxed">
          Link your <a href="https://hardcover.app" target="_blank" rel="noopener" class="text-[var(--accent)] hover:underline">Hardcover</a> account
          and Tome keeps your public profile current — ratings (half-stars included), reading progress,
          finish dates. One-way and opt-in: Tome writes, never deletes.
        </p>
        <p class="text-lg md:text-xl text-[var(--muted)] leading-relaxed mt-4">
          If you haven't met Hardcover yet: it's the indie, community-run Goodreads alternative —
          ad-free, actively built in the open, with a proper public API. Exactly the kind of
          neighbour a self-hosted library wants.
        </p>
      </div>
      <div class="reveal screenshot-card rounded-xl overflow-hidden border bg-[var(--card)] shadow-xl md:order-1">
        <ThemedShot name="hardcover" alt="The Hardcover sync page in Tome" client:load className="w-full block" />
      </div>
    </div>
  </section>

  <!-- 365-day heatmap moment -->
  <section class="max-w-4xl mx-auto px-6 py-24">
    <div class="text-center mb-10 reveal">
      <span class="inline-block px-3 py-1 mb-4 rounded-full text-xs font-medium bg-[var(--accent-soft)] text-[var(--accent)] uppercase tracking-wide">365 days</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">A year of reading, at a glance.</h2>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto leading-relaxed">
        Every cell is a day. Every shade is how much you read. Recognise your patterns — the weekend deep-dives,
        the late-night chapters, the dry spells.
      </p>
    </div>
    <div class="reveal rounded-xl border bg-[var(--card)] shadow-xl">
      <HeatmapFillIn client:load />
    </div>
  </section>

  <!-- Theme picker -->
  <section class="max-w-5xl mx-auto px-6 py-24">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Pick a theme. Read your way.</h2>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto leading-relaxed">
        Five themes built in: Light, Dark, Black, Amber and Ember, plus custom palettes for the colour-coordinators.
        Click below to try one. (Your choice carries into the docs too.)
      </p>
    </div>
    <div class="reveal">
      <ThemePickerRow client:load />
    </div>
  </section>
  <!-- Mobile / PWA — phone-frame trio -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Pin it to your home screen.</h2>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto leading-relaxed">
        Tome ships as a PWA. Install it like a native app — sidebar nav, full-bleed reader, sync status in your pocket.
      </p>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto leading-relaxed mt-4">
        On iPhone there is also a native app, <a href="https://testflight.apple.com/join/JrHyntNU" target="_blank" rel="noopener" class="text-[var(--accent)] hover:underline">in free beta until 31 December 2026</a>.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 reveal max-w-4xl mx-auto">
      <div class="mobile-shot screenshot-card">
        <ThemedShot name="mobile-home" alt="Mobile home" client:load className="w-full block" />
      </div>
      <div class="mobile-shot screenshot-card">
        <ThemedShot name="mobile-reader" alt="Mobile reader" client:load className="w-full block" />
      </div>
      <div class="mobile-shot screenshot-card">
        <ThemedShot name="mobile-stats" alt="Mobile stats" client:load className="w-full block" />
      </div>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h2 class="reveal text-3xl md:text-5xl font-bold tracking-tight mb-6">Who Tome is for.</h2>
    <p class="reveal text-lg md:text-xl text-[var(--muted)] leading-relaxed mb-5">
      People who read on an e-reader with KOReader and want their library to keep track of it:
      every sitting, every position, every highlight. It is one small container with SQLite, and
      your books can stay on the NAS where they already are.
    </p>
    <p class="reveal text-base text-[var(--muted)] leading-relaxed">
      See <a href="/why" class="text-[var(--accent)] hover:underline">how Tome compares with Calibre-Web, Kavita, Komga, Grimmory and BookOrbit</a>.
    </p>
  </section>

  <!-- Closing CTA -->
  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h2 class="reveal text-3xl md:text-5xl font-bold tracking-tight mb-4">Ship it in 60 seconds.</h2>
    <p class="reveal text-lg text-[var(--muted)] mb-8">One Docker image. SQLite under the hood. No external services required.</p>
    <div class="reveal relative">
      <pre class="text-left rounded-lg p-5 pr-20 bg-[var(--card)] border text-sm overflow-x-auto"><code set:html={shipCommand}></code></pre>
      <div class="absolute top-3 right-3">
        <CopyButton text={shipCommand} client:load />
      </div>
    </div>
  </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-[var(--border)]">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--fg)] mb-3">Product</h3>
          <ul class="space-y-2 text-sm text-[var(--muted)]">
            <li><a href="/why" class="hover:text-[var(--fg)] transition-colors">Why Tome?</a></li>
            <li><a href="/docs" class="hover:text-[var(--fg)] transition-colors">Docs</a></li>
            <li><a href="/docs/installation" class="hover:text-[var(--fg)] transition-colors">Installation</a></li>
            <li><a href="/docs/changelog" class="hover:text-[var(--fg)] transition-colors">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--fg)] mb-3">Features</h3>
          <ul class="space-y-2 text-sm text-[var(--muted)]">
            <li><a href="/docs/koreader" class="hover:text-[var(--fg)] transition-colors">KOReader / TomeSync</a></li>
            <li><a href="/docs/opds" class="hover:text-[var(--fg)] transition-colors">OPDS</a></li>
            <li><a href="/docs/stats" class="hover:text-[var(--fg)] transition-colors">Stats</a></li>
            <li><a href="/docs/reader" class="hover:text-[var(--fg)] transition-colors">Web reader</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--fg)] mb-3">Admin</h3>
          <ul class="space-y-2 text-sm text-[var(--muted)]">
            <li><a href="/docs/users-and-roles" class="hover:text-[var(--fg)] transition-colors">Users &amp; roles</a></li>
            <li><a href="/docs/bindery" class="hover:text-[var(--fg)] transition-colors">Bindery</a></li>
            <li><a href="/docs/api-tokens" class="hover:text-[var(--fg)] transition-colors">API tokens</a></li>
            <li><a href="/docs/configuration" class="hover:text-[var(--fg)] transition-colors">Configuration</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--fg)] mb-3">Community</h3>
          <ul class="space-y-2 text-sm text-[var(--muted)]">
            <li><a href="https://github.com/bndct-devops/tome" class="hover:text-[var(--fg)] transition-colors">GitHub</a></li>
            <li><a href="https://github.com/bndct-devops/tome/issues" class="hover:text-[var(--fg)] transition-colors">Issues</a></li>
            <li><a href="https://github.com/bndct-devops/tome/discussions" class="hover:text-[var(--fg)] transition-colors">Discussions</a></li>
          </ul>
        </div>
      </div>
      <div class="flex flex-col md:flex-row items-center justify-between gap-3 pt-6 border-t border-[var(--border)] text-sm text-[var(--muted)]">
        <div>AGPL-3.0 · <a href="https://github.com/bndct-devops/tome" class="hover:text-[var(--fg)] transition-colors">bndct-devops/tome</a></div>
        <div>{releaseLabel}</div>
      </div>
    </div>
  </footer>

  <RevealOnScroll client:load />
</BaseLayout>
